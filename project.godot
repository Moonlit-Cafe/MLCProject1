; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

"Signal Lens/resize_panel_on_open"=false
"Signal Lens/height_to_resize_to"=400.0

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="GameJamTemplate"
config/version="2025.6.2-template.b132d5"
run/main_scene="uid://bf0e0l206u8xd"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://dvht62llvfwqd"

[autoload]

SaveManager="*res://autoloads/saving/save_manager.gd"
GameGlobal="*res://autoloads/general/game_global.gd"
GameGlobalEvents="*res://autoloads/general/game_global_events.gd"
AudioManager="*uid://bamjugiicnyji"
CraftManager="*res://autoloads/player/craft_manager.tscn"
PlayerManager="*res://autoloads/player/player_manager.tscn"
SceneManager="*res://autoloads/scenes/scene_manager.tscn"
CombatManager="*res://autoloads/combat/combat_manager.tscn"
MouseHandler="*res://autoloads/player/mouse_handler.tscn"
Debug="*res://autoloads/debug/debug.tscn"
SignalLens="*res://addons/signal_lens/autoload/signal_lens_autoload.gd"
ResourceManager="*uid://dy2swoshyhmu5"

[display]

window/size/resizable=false
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/CSVAccess/plugin.cfg", "res://addons/Todo_Manager/plugin.cfg", "res://addons/signal_lens/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "pink",
"res://autoloads/": "yellow",
"res://entities/": "blue",
"res://mechanics/": "red",
"res://ui/": "green",
"res://utility/": "purple"
}

[global_group]

saveable="Nodes that should have the \"save()\" function and can thus be saved as data to a .save file"

