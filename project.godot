; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

"Signal Lens/resize_panel_on_open"=false
"Signal Lens/height_to_resize_to"=400.0

[application]

config/name="CraftingCrawler"
config/version="0.1.0-Dev160426"
run/main_scene="uid://bsrix6xqd4qc8"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

SignalLens="*uid://b2i17epm4xyji"
Global="*uid://jk2uy5qv2ure"
GlobalResources="*uid://cf1bgcwmpx0gp"
GlobalSettings="*uid://c8ev58vkcgkfx"

[display]

window/size/resizable=false
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="CraftingCrawler"

[editor_plugins]

enabled=PackedStringArray("res://addons/Todo_Manager/plugin.cfg", "res://addons/signal_lens/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "pink",
"res://autoloads/": "yellow",
"res://entities/": "blue",
"res://mechanics/": "red",
"res://scenes/": "gray",
"res://utility/": "purple"
}

[global_group]

saveable="Nodes that should have the \"save()\" function and can thus be saved as data to a .save file"
player="Group of player entities across timelines"

